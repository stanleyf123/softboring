# Public origin. On the VPS this is https://softboring.com — see DEPLOY-LINODE.md
SITE_URL=http://localhost:3000

# SQLite file for users, sessions, and weekly reviews.
SQLITE_PATH=./data/softboring.sqlite
# VPS (separate from 99gold):
# SQLITE_PATH=/var/www/softboring/data/softboring.sqlite

# Admin backend token for /admin (Bearer header, x-admin-token, or login form).
# Generate with: openssl rand -hex 32
# Leave empty locally until you need /admin. Never commit a real value.
ADMIN_TOKEN=

# Optional later — not used yet
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional later — not used yet (paid plans)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
