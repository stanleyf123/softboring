# Public origin. On the VPS this is https://softboring.com — see DEPLOY-LINODE.md
SITE_URL=http://localhost:3000

# SQLite file for users, sessions, and weekly reviews.
SQLITE_PATH=./data/softboring.sqlite
# VPS (separate from 99gold):
# SQLITE_PATH=/var/www/softboring/data/softboring.sqlite

# Admin backend token for /admin (Bearer header, x-admin-token, or login form).
# Generate with: openssl rand -hex 32
# Leave empty locally until you need /admin. Never commit a real value.
ADMIN_TOKEN=

# Stripe subscriptions (Soft+). Leave blank locally to keep checkout disabled.
# The pricing page still renders; buttons show "payments not configured".
# Never commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
# Optional yearly price
STRIPE_PRICE_YEARLY=
# Optional. Checkout is created on the server, so this is not required.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional one-time Soft Wall sticker prices. If unset, Checkout still works
# when Stripe is configured, using catalog cents via price_data.
# STRIPE_PRICE_STICKER_PACK=
# STRIPE_PRICE_STICKER_STAR=
# STRIPE_PRICE_STICKER_HEART=
# STRIPE_PRICE_STICKER_SPROUT=
# STRIPE_PRICE_STICKER_TEA=
# STRIPE_PRICE_STICKER_MOON=
# STRIPE_PRICE_STICKER_CLOUD=
# STRIPE_PRICE_STICKER_PEACH=
# STRIPE_PRICE_STICKER_SPARKLE=

# Google Analytics (gtag.js) on public pages. Inlined at `next build`.
# Defaults to G-MFQ9J6B9DH if unset. Override here to change the property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MFQ9J6B9DH

# Google Login. Both required to enable "Continue with Google".
# Callback: {SITE_URL}/api/auth/oauth/google/callback
# Production: https://softboring.com/api/auth/oauth/google/callback
# Scopes: openid email profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login. Both required to enable "Continue with LINE".
# Callback: {SITE_URL}/api/auth/oauth/line/callback
# Production: https://softboring.com/api/auth/oauth/line/callback
# Scopes: profile openid email (email is optional; users may decline)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Optional email for password reset and weekly reminders.
# Prefer RESEND_API_KEY. SMTP works too (99gold-style). If both are empty,
# forgot-password still creates a token and logs the link; the UI says email
# is not configured. reminders:dispatch no-ops successfully.
EMAIL_FROM=Soft Boring Weekly <noreply@softboring.com>
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Optional later — not used yet
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
